# Copy to .env for local testing, and add the same values in your host's dashboard (Vercel > Settings > Environment Variables).
# Never commit the real .env file: it holds passwords.

# --- Option 1 (recommended): send through your own mailbox over SMTP ---
# skandava.com has strict email rules (DMARC "reject", SPF for GoDaddy only), so mail sent as @skandava.com
# from any other service is rejected. Sending through your own mailbox passes those checks.
# GoDaddy Workspace Email: smtpout.secureserver.net, port 465. Check your mailbox settings in GoDaddy for the exact server.
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_USER=hariprasad@skandava.com
SMTP_PASS=

# --- Option 2: Resend (only if you also add Resend's DKIM and SPF records for skandava.com) ---
# From resend.com > API Keys
RESEND_API_KEY=

# --- Both options ---
# Where enquiries are delivered
CONTACT_TO=hariprasad@skandava.com

# Optional. With SMTP this must be the mailbox (or an alias of it); it defaults to SMTP_USER.
# With Resend it must be on a domain you verified in Resend, for example:
# CONTACT_FROM="Skandava Website <website@skandava.com>"
