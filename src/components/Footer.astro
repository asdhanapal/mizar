---
import { getCollection } from 'astro:content';
import { site } from '../site';
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
---

<footer class="relative z-10 bg-fog text-[12px] leading-relaxed text-muted">
  <div class="mx-auto max-w-[1024px] px-5 py-12">
    <a href="/" class="mb-6 inline-block" aria-label={`${site.name} home`}><img src="/logo.png" alt={site.name} width="100" height="26" class="h-[26px] w-auto" loading="lazy" /></a>
    <p class="border-b border-line pb-4">Looking for something specific? <a class="text-link hover:underline" href="/contact/">Talk to us</a> or email <a class="text-link hover:underline" href={`mailto:${site.email}`}>{site.email}</a>.</p>
    <div class="grid gap-8 border-b border-line py-8 sm:grid-cols-3">
      <nav aria-label="Services">
        <p class="mb-2 font-semibold text-ink">Services</p>
        <ul class="space-y-1.5">{services.map((s) => <li><a class="hover:underline" href={`/services/${s.id}/`}>{s.data.title}</a></li>)}</ul>
      </nav>
      <nav aria-label="Product">
        <p class="mb-2 font-semibold text-ink">Product and tools</p>
        <ul class="space-y-1.5"><li><a class="hover:underline" href="/core/">CORE caller app</a></li>
          <li><a class="hover:underline" href="/tools/">Free tools</a></li>
          <li><a class="hover:underline" href="/tools/whatsapp-link-generator/">WhatsApp link generator</a></li>
          <li><a class="hover:underline" href="/tools/utm-link-builder/">UTM link builder</a></li></ul>
      </nav>
      <nav aria-label="Company">
        <p class="mb-2 font-semibold text-ink">Company</p>
        <ul class="space-y-1.5">
          <li><a class="hover:underline" href="/about/">About</a></li>
          <li><a class="hover:underline" href="/blog/">Blog</a></li>
          <li><a class="hover:underline" href="/partners/">Partners</a></li>
          <li><a class="hover:underline" href="/contact/">Contact</a></li>
          <li><a class="hover:underline" href="/privacy/">Privacy</a></li>
        </ul>
      </nav>
    </div>
    <p class="pt-4">{site.name} is based in {site.location.neighbourhood}, {site.location.locality}, {site.location.region}.</p>
    <p>Copyright © {new Date().getFullYear()} {site.name}. All rights reserved.</p>
  </div>
</footer>
