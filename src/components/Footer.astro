---
import { getCollection } from 'astro:content';
import { site } from '../site';
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
---

<footer class="relative z-10 mt-32 border-t border-line bg-bg">
  <div class="container-x py-16">
    <div class="grid gap-12 md:grid-cols-[1.5fr_1fr_1fr_1fr]">
      <div>
        <p class="font-display text-2xl font-semibold">{site.name}<span class="text-accent-2">.</span></p>
        <p class="mt-4 max-w-xs text-sm text-muted">{site.tagline}</p>
      </div>
      <nav aria-label="Services">
        <p class="eyebrow mb-4">Services</p>
        <ul class="space-y-2 text-sm text-muted">
          {services.map((s) => <li><a class="hover:text-white" href={`/services/${s.id}/`}>{s.data.title}</a></li>)}
        </ul>
      </nav>
      <nav aria-label="Company">
        <p class="eyebrow mb-4">Company</p>
        <ul class="space-y-2 text-sm text-muted">
          <li><a class="hover:text-white" href="/core/">CORE Caller App</a></li>
          <li><a class="hover:text-white" href="/about/">About</a></li>
          <li><a class="hover:text-white" href="/blog/">Blog</a></li>
          <li><a class="hover:text-white" href="/contact/">Contact</a></li>
        </ul>
      </nav>
      <div>
        <p class="eyebrow mb-4">Talk to us</p>
        <a class="text-sm text-muted hover:text-white" href={`mailto:${site.email}`}>{site.email}</a>
        <div class="mt-4"><a href="/contact/" class="btn btn-ghost">Book a free consultation</a></div>
      </div>
    </div>
    <p class="mt-14 border-t border-line pt-6 text-xs text-muted">© {new Date().getFullYear()} {site.name}. All rights reserved.</p>
  </div>
</footer>
