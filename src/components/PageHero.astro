---
import Abstract from './Abstract.astro';
interface Props { title: string; lead?: string; crumbs?: { label: string; href?: string }[] }
const { title, lead, crumbs = [] } = Astro.props;
---

<section class="wash relative overflow-hidden pt-32 pb-14 text-center sm:pt-40">
  <Abstract variant="network" class="-right-40 -top-32 h-[34rem] w-[34rem] opacity-40 max-sm:hidden" />
  <div class="container-x">
    {crumbs.length > 0 && (
      <nav aria-label="Breadcrumb" class="mb-5 text-sm text-muted">
        {crumbs.map((c, i) => (
          <>
            {c.href ? <a href={c.href} class="hover:text-ink hover:underline">{c.label}</a> : <span>{c.label}</span>}
            {i < crumbs.length - 1 && <span class="mx-2" aria-hidden="true">/</span>}
          </>
        ))}
      </nav>
    )}
    <h1 class="h1 mx-auto max-w-4xl">{title}</h1>
    {lead && <p class="lead mx-auto mt-6 max-w-2xl">{lead}</p>}
  </div>
</section>
