---
interface Props { variant?: 'network' | 'helix'; class?: string; seed?: number }
const { variant = 'network', class: cls = '', seed = 4 } = Astro.props;

function rng(s: number) {
  let a = s >>> 0;
  return () => { a = (a + 0x6d2b79f5) >>> 0; let t = a; t = Math.imul(t ^ (t >>> 15), t | 1); t ^= t + Math.imul(t ^ (t >>> 7), t | 61); return ((t ^ (t >>> 14)) >>> 0) / 4294967296; };
}

// Network: scattered nodes joined to their near neighbours
const r = rng(seed);
const nodes = Array.from({ length: 34 }, () => ({ x: 30 + r() * 540, y: 30 + r() * 540, r: 2 + r() * 3.2 }));
const links: { x1: number; y1: number; x2: number; y2: number }[] = [];
nodes.forEach((a, i) => {
  nodes.map((b, j) => ({ b, j, d: Math.hypot(a.x - b.x, a.y - b.y) }))
    .filter((o) => o.j > i && o.d < 150)
    .sort((p, q) => p.d - q.d).slice(0, 3)
    .forEach(({ b }) => links.push({ x1: a.x, y1: a.y, x2: b.x, y2: b.y }));
});

// Helix: two strands with rungs between them
const N = 46;
const strandA: string[] = [], strandB: string[] = [];
const rungs: { x: number; y1: number; y2: number; o: number }[] = [];
for (let i = 0; i <= 120; i++) {
  const x = (i / 120) * 1200, a = (i / 120) * Math.PI * 2 * 4.5;
  strandA.push(`${i ? 'L' : 'M'}${x.toFixed(1)} ${(100 + Math.sin(a) * 62).toFixed(1)}`);
  strandB.push(`${i ? 'L' : 'M'}${x.toFixed(1)} ${(100 + Math.sin(a + Math.PI) * 62).toFixed(1)}`);
}
for (let i = 0; i < N; i++) {
  const x = (i / (N - 1)) * 1200, a = (i / (N - 1)) * Math.PI * 2 * 4.5;
  rungs.push({ x, y1: 100 + Math.sin(a) * 62, y2: 100 + Math.sin(a + Math.PI) * 62, o: 0.35 + 0.65 * Math.abs(Math.cos(a)) });
}
---

{variant === 'network' ? (
  <svg class:list={['pointer-events-none absolute [mask-image:radial-gradient(closest-side,#000_45%,transparent)]', cls]} viewBox="0 0 600 600" fill="none" aria-hidden="true">
    <defs>
      <linearGradient id="ab-n" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#227e0d" />
        <stop offset="1" stop-color="#5dd435" />
      </linearGradient>
    </defs>
    <g stroke="url(#ab-n)" stroke-opacity=".3" stroke-width="1">
      {links.map((l) => <line x1={l.x1} y1={l.y1} x2={l.x2} y2={l.y2} />)}
    </g>
    <g fill="url(#ab-n)" fill-opacity=".55">
      {nodes.map((n) => <circle cx={n.x} cy={n.y} r={n.r} />)}
    </g>
  </svg>
) : (
  <svg class:list={['pointer-events-none absolute [mask-image:linear-gradient(90deg,transparent,#000_18%,#000_82%,transparent)]', cls]} viewBox="0 0 1200 200" fill="none" preserveAspectRatio="none" aria-hidden="true">
    <defs>
      <linearGradient id="ab-h" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#227e0d" />
        <stop offset="1" stop-color="#5dd435" />
      </linearGradient>
    </defs>
    <g stroke="url(#ab-h)" stroke-width="1">
      {rungs.map((g) => <line x1={g.x} y1={g.y1} x2={g.x} y2={g.y2} stroke-opacity={(g.o * 0.28).toFixed(2)} />)}
    </g>
    <path d={strandA.join(' ')} stroke="url(#ab-h)" stroke-opacity=".5" stroke-width="1.6" />
    <path d={strandB.join(' ')} stroke="url(#ab-h)" stroke-opacity=".5" stroke-width="1.6" />
  </svg>
)}
