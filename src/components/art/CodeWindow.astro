---
const code = `<span class="k">export async function</span> <span class="f">syncCall</span>(call: Call) {
  <span class="k">const</span> url = <span class="k">await</span> <span class="f">presign</span>(call.id);
  <span class="k">await</span> <span class="f">upload</span>(call.audio, url);
  <span class="k">await</span> crm.<span class="f">log</span>({
    lead: call.leadId,
    recording: url,
    seconds: call.duration,
  });
  <span class="c">// visible to managers in seconds</span>
}`;
---

<div class="win" role="img" aria-label="Illustration: a code editor showing a function that uploads a call recording and logs it to a CRM">
  <div class="bar"><i></i><i></i><i></i><span>sync-call.ts</span></div>
<pre><code set:html={code} /></pre>
</div>

