---
import { site } from '../site';
const path = Astro.url.pathname;
---

<header class="fixed inset-x-0 top-0 z-50 h-16 border-b border-black/10 bg-[rgba(255,255,255,0.8)] backdrop-blur-xl backdrop-saturate-150">
  <div class="mx-auto flex h-full max-w-[1024px] items-center justify-between px-5">
    <a href="/" class="flex items-center" aria-label={`${site.name} home`}>
      <img src="/logo.png" alt={site.name} width="130" height="34" class="h-[34px] w-auto" />
    </a>

    <nav aria-label="Primary" class="hidden items-center gap-10 text-[14px] md:flex">
      {site.nav.map((item) => (
        <a href={item.href} class:list={['transition-colors hover:text-ink', path.startsWith(item.href) ? 'text-ink' : 'text-[rgba(29,29,31,0.72)]']}>{item.label}</a>
      ))}
    </nav>

    <details class="group md:hidden">
      <summary class="flex h-16 w-10 cursor-pointer list-none items-center justify-end text-ink" aria-label="Menu">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M3 9h18M3 15h18" /></svg>
      </summary>
      <nav aria-label="Mobile" class="fixed inset-x-0 top-16 border-b border-black/10 bg-[rgba(255,255,255,0.97)] px-5 pb-8 pt-2 backdrop-blur-xl">
        {site.nav.map((item) => <a href={item.href} class="block border-b border-black/10 py-3.5 text-[22px] font-semibold text-ink">{item.label}</a>)}
      </nav>
    </details>
  </div>
</header>
