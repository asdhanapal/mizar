---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../site';

const field = 'w-full rounded-xl border border-line bg-white px-4 py-3.5 text-[1.05rem] text-ink outline-none transition focus:border-blue focus:ring-4 focus:ring-blue/15';
---

<Base
  title="Contact: Book a Free Consultation"
  description="Tell us about your project. Skandava will reply with an honest view of scope, timeline and next steps. Book a free consultation."
  jsonLd={[{ '@context': 'https://schema.org', '@type': 'ContactPage', name: 'Contact Skandava', url: 'https://skandava.com/contact/' }]}
>
  <PageHero title="Let's talk about your project." lead="Tell us what you are building or where you want to grow. We will reply with an honest view of scope and next steps." crumbs={[{ label: 'Contact' }]} />
  <section class="container-x max-w-xl pb-16">
    <!-- TODO: connect to a real backend (Cloudflare Function, Resend, Formspree). Currently composes an email. -->
    <form id="contact-form" class="grid gap-5" novalidate>
      <label class="grid gap-2 text-sm font-medium">Full name<input name="name" required autocomplete="name" class={field} /></label>
      <label class="grid gap-2 text-sm font-medium">Email<input name="email" type="email" required autocomplete="email" class={field} /></label>
      <label class="grid gap-2 text-sm font-medium">Phone (optional)<input name="phone" type="tel" autocomplete="tel" class={field} /></label>
      <label class="grid gap-2 text-sm font-medium">How can we help?<textarea name="message" rows="5" required class={field}></textarea></label>
      <button class="btn btn-primary mt-2 w-full" type="submit">Send message</button>
      <p class="text-center text-sm text-muted">Or email us at <a class="text-link hover:underline" href={`mailto:${site.email}`}>{site.email}</a>.</p>
    </form>
  </section>
  <script define:vars={{ to: site.email }}>
    document.getElementById('contact-form')?.addEventListener('submit', (e) => {
      e.preventDefault();
      const f = e.currentTarget;
      if (!f.reportValidity()) return;
      const d = new FormData(f);
      const body = `Name: ${d.get('name')}\nEmail: ${d.get('email')}\nPhone: ${d.get('phone') || '-'}\n\n${d.get('message')}`;
      location.href = `mailto:${to}?subject=${encodeURIComponent('Website enquiry from ' + d.get('name'))}&body=${encodeURIComponent(body)}`;
    });
  </script>
</Base>
