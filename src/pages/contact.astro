---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../site';
---

<Base
  title="Contact — Book a Free Consultation"
  description="Tell us about your project. Skandava will reply with an honest view of scope, timeline and next steps. Book a free consultation."
  jsonLd={[{ '@context': 'https://schema.org', '@type': 'ContactPage', name: 'Contact Skandava', url: 'https://skandava.com/contact/' }]}
>
  <PageHero eyebrow="Contact" title="Let's talk about your project." lead="Tell us what you are building or where you want to grow. We will reply with an honest view of scope and next steps." />
  <section class="container-x max-w-2xl pb-8">
    <!-- TODO: connect to a real backend (Cloudflare Function, Resend, Formspree). Currently composes an email. -->
    <form id="contact-form" class="grid gap-5" novalidate>
      <label class="grid gap-2 text-sm">Full name
        <input name="name" required autocomplete="name" class="rounded-xl border border-line bg-surface px-4 py-3 text-base text-fg" />
      </label>
      <label class="grid gap-2 text-sm">Email
        <input name="email" type="email" required autocomplete="email" class="rounded-xl border border-line bg-surface px-4 py-3 text-base text-fg" />
      </label>
      <label class="grid gap-2 text-sm">Phone (optional)
        <input name="phone" type="tel" autocomplete="tel" class="rounded-xl border border-line bg-surface px-4 py-3 text-base text-fg" />
      </label>
      <label class="grid gap-2 text-sm">How can we help?
        <textarea name="message" rows="5" required class="rounded-xl border border-line bg-surface px-4 py-3 text-base text-fg"></textarea>
      </label>
      <button class="btn btn-primary" type="submit">Send message</button>
      <p class="text-sm text-muted">Or email us at <a class="text-accent-2 underline" href={`mailto:${site.email}`}>{site.email}</a>.</p>
    </form>
  </section>
  <script define:vars={{ to: site.email }}>
    document.getElementById('contact-form')?.addEventListener('submit', (e) => {
      e.preventDefault();
      const f = e.currentTarget;
      if (!f.reportValidity()) return;
      const d = new FormData(f);
      const body = `Name: ${d.get('name')}\nEmail: ${d.get('email')}\nPhone: ${d.get('phone') || '-'}\n\n${d.get('message')}`;
      location.href = `mailto:${to}?subject=${encodeURIComponent('Website enquiry from ' + d.get('name'))}&body=${encodeURIComponent(body)}`;
    });
  </script>
</Base>
