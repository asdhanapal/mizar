---
import { render } from 'astro:content';
import { getPosts } from '../../lib/posts';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const url = `https://skandava.com/blog/${entry.id}/`;
---

<Base
  title={data.title}
  description={data.description}
  type="article"
  publishedTime={data.pubDate}
  modifiedTime={data.updatedDate ?? data.pubDate}
  jsonLd={[{
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: data.title,
    description: data.description,
    datePublished: data.pubDate.toISOString(),
    dateModified: (data.updatedDate ?? data.pubDate).toISOString(),
    mainEntityOfPage: url,
    author: { '@id': 'https://skandava.com/#organization' },
    publisher: { '@id': 'https://skandava.com/#organization' },
  }]}
>
  <PageHero title={data.title} lead={data.description} crumbs={[{ label: 'Blog', href: '/blog/' }, { label: data.title }]} />
  <article class="container-x max-w-3xl pb-8">
    <time datetime={data.pubDate.toISOString()} class="block text-center text-sm text-muted">{data.pubDate.toLocaleDateString('en-GB', { dateStyle: 'long' })}</time>
    <div class="prose-site mt-6"><Content /></div>
  </article>

  <section class="container-x max-w-3xl py-16">
    <div class="tile tile-light px-8 py-12">
      <h2 class="h3">Want this solved for your team?</h2>
      <p class="sub mx-auto mt-3 max-w-md text-[1.2rem] leading-snug">Tell us what you are dealing with and we will reply with an honest view of the options.</p>
      <div class="mt-7 flex flex-wrap items-center justify-center gap-x-8 gap-y-4">
        <a href="/contact/" class="btn btn-primary">Book a consultation</a>
        {data.related && <a href={data.related.href} class="link text-[1.2rem]">{data.related.label}</a>}
      </div>
    </div>
  </section>
</Base>
