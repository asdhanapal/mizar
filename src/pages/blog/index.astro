---
import { getPosts } from '../../lib/posts';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';

const posts = await getPosts();
---

<Base title="Blog: Software, SEO & Growth Insights" description="Practical articles on software development, SEO, cloud and customer communication from the Skandava team.">
  <PageHero title="Notes from the engineering desk." crumbs={[{ label: 'Blog' }]} />
  <section class="container-x max-w-3xl pb-16">
    <ul class="divide-y divide-line border-y border-line">
      {posts.map((p) => (
        <li>
          <a href={`/blog/${p.id}/`} class="group block py-8">
            <time datetime={p.data.pubDate.toISOString()} class="text-sm text-muted">{p.data.pubDate.toLocaleDateString('en-GB', { dateStyle: 'long' })}</time>
            <h2 class="mt-2 text-[2rem] group-hover:text-link">{p.data.title}{p.data.draft && <span class="ml-3 rounded-full bg-fog px-3 py-1 align-middle text-xs font-medium text-muted">Draft</span>}</h2>
            <p class="mt-2 text-[1.1rem] leading-snug text-muted">{p.data.description}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>
