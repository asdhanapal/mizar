---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="The page you are looking for does not exist." noindex>
  <section class="container-x flex min-h-[70vh] flex-col items-start justify-center">
    <p class="eyebrow mb-4">404</p>
    <h1 class="h1">This page wandered off.</h1>
    <a href="/" class="btn btn-primary mt-8">Back to home</a>
  </section>
</Base>
