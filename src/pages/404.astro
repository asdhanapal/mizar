---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="The page you are looking for does not exist." noindex>
  <section class="container-x flex min-h-[70vh] flex-col items-start justify-center pt-24">
    <h1 class="h1">This page wandered off.</h1>
    <p class="lead mt-6">The link may be old or mistyped. Head back to the homepage or browse our services.</p>
    <div class="mt-9 flex flex-wrap items-center gap-x-8 gap-y-4"><a href="/" class="btn btn-primary">Go to homepage</a><a href="/services/" class="link text-[1.2rem]">Browse services</a></div>
  </section>
</Base>
