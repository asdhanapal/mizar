---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PhoneCall from '../../components/art/PhoneCall.astro';
import ChatMock from '../../components/art/ChatMock.astro';
import SerpMock from '../../components/art/SerpMock.astro';
import CodeWindow from '../../components/art/CodeWindow.astro';
import ArchDiagram from '../../components/art/ArchDiagram.astro';
import DashMock from '../../components/art/DashMock.astro';
import Abstract from '../../components/Abstract.astro';
import { getPosts } from '../../lib/posts';
import { site } from '../../site';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const look: Record<string, { dark: boolean; Art: any }> = {
  'saas-development': { dark: false, Art: DashMock },
  'seo-digital-marketing': { dark: false, Art: SerpMock },
  'web-development': { dark: true, Art: CodeWindow },
  'whatsapp-messaging': { dark: false, Art: ChatMock },
  'cloud-aws': { dark: false, Art: ArchDiagram },
  'crm-integration-development': { dark: false, Art: DashMock },
  'android-app-development': { dark: false, Art: ChatMock },
  'it-services': { dark: false, Art: ArchDiagram },
};

const washes: Record<string, string> = { 'saas-development': '', 'seo-digital-marketing': 'wash-green', 'web-development': 'wash-amber', 'whatsapp-messaging': 'wash-green', 'cloud-aws': '', 'crm-integration-development': '', 'android-app-development': 'wash-green', 'it-services': 'wash-amber' };
const kinds: Record<string, string> = { 'saas-development': 'saas', 'seo-digital-marketing': 'cards', 'web-development': 'laptop', 'whatsapp-messaging': 'chat', 'cloud-aws': 'stack', 'crm-integration-development': 'saas', 'android-app-development': 'chat', 'it-services': 'stack' };

const { entry } = Astro.props;
const { data } = entry;
const { dark, Art } = look[entry.id] ?? { dark: false, Art: PhoneCall };
const { Content } = await render(entry);
const url = `https://www.skandava.com/services/${entry.id}/`;

// Every article that says it belongs to this service is linked here automatically, so new posts never start as orphans.
const guides = (await getPosts()).filter((p) => p.data.related?.href === `/services/${entry.id}/`);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    '@id': `${url}#service`,
    name: data.title,
    serviceType: data.title,
    description: data.description,
    url,
    provider: { '@id': 'https://www.skandava.com/#organization' },
    ...(site.areaServed.length ? { areaServed: site.areaServed } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.skandava.com/' },
      { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://www.skandava.com/services/' },
      { '@type': 'ListItem', position: 3, name: data.title, item: url },
    ],
  },
  ...(data.faq.length
    ? [{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: data.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }]
    : []),
];
---

<Base title={data.seoTitle} description={data.description} jsonLd={jsonLd}>
  <script is:inline slot="head">
    try {
      var c = document.createElement('canvas');
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches && (navigator.hardwareConcurrency || 8) > 2 && !(navigator.connection && navigator.connection.saveData) && !(matchMedia('(pointer: coarse)').matches && ((navigator.deviceMemory || 8) <= 4 || (navigator.hardwareConcurrency || 8) <= 4)) && (c.getContext('webgl2') || c.getContext('webgl'))) document.documentElement.classList.add('svc-on');
    } catch (e) {}
  </script>

  <!-- 3D hero: pinned while you scroll. Without WebGL it falls back to a plain hero plus the 2D mockup below. -->
  <section id="svc" class="svc" aria-label={data.title}>
    <div class:list={['svc-stage wash', washes[entry.id]]}>
      <canvas id="stage" data-kind={kinds[entry.id]} aria-hidden="true" class="svc-canvas"></canvas>
      <div class="container-x svc-inner">
        <div class="svc-copy">
          <nav aria-label="Breadcrumb" class="mb-5 text-sm text-muted">
            <a href="/services/" class="hover:text-ink hover:underline">Services</a><span class="mx-2" aria-hidden="true">/</span><span>{data.title}</span>
          </nav>
          <h1 class="h1" style="font-size:clamp(2.8rem,6.4vw,5rem)">{data.title}</h1>
          <p class="lead mt-6">{data.summary}</p>
          <div class="svc-cta mt-8 flex flex-wrap items-center gap-x-8 gap-y-4">
            <a href="/contact/" class="btn btn-primary">Book a consultation</a>
            <a href="#what-h" class="link text-[1.2rem]">See what you get</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="svc-fallback mx-auto mt-16 max-w-[1200px] px-3">
    <div class:list={['tile overflow-hidden px-6 py-16 sm:py-16', dark ? 'tile-dark' : 'tile-light']}><Art /></div>
  </section>

{data.answer && (
    <section class="container-x max-w-3xl pt-16" aria-label="In short">
      <div class="rounded-3xl bg-fog px-7 py-6 sm:px-9 sm:py-7">
        <p class="text-sm font-semibold text-muted">In short</p>
        <p class="mt-2 text-[1.25rem] leading-snug tracking-tight">{data.answer}</p>
      </div>
    </section>
  )}


  <section class="container-x py-20" aria-labelledby="what-h">
    <h2 id="what-h" class="h2 max-w-2xl">What you get.</h2>
    <div class="mt-14 grid gap-x-14 gap-y-12 sm:grid-cols-2">
      {data.features.map((f) => (
        <div>
          <h3 class="text-[1.6rem]">{f.title}</h3>
          <p class="mt-3 text-[1.1rem] leading-snug text-muted">{f.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-fog py-16">
    <div class="container-x max-w-3xl"><div class="prose-site"><Content /></div></div>
  </section>

  {data.faq.length > 0 && (
    <section class="container-x max-w-3xl py-20" aria-labelledby="faq-h">
      <h2 id="faq-h" class="h2 mb-10">Questions we hear a lot.</h2>
      <div class="divide-y divide-line border-y border-line">
        {data.faq.map((f) => (
          <details class="group py-6">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-[1.3rem] font-semibold tracking-tight">
              {f.q}<span class="text-2xl font-light text-muted transition group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <p class="mt-4 max-w-2xl text-[1.1rem] leading-relaxed text-muted">{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  )}

  {guides.length > 0 && (
    <section class="container-x max-w-3xl pb-20" aria-labelledby="guides-h">
      <h2 id="guides-h" class="h2 mb-10">Guides on this topic.</h2>
      <ul class="divide-y divide-line border-y border-line">
        {guides.map((g) => (
          <li class="py-5">
            <a href={`/blog/${g.id}/`} class="link text-[1.3rem] font-semibold tracking-tight">{g.data.title}</a>
            <p class="mt-1 text-[1.05rem] leading-snug text-muted">{g.data.description}</p>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="container-x pb-20 text-center">
    <h2 class="h2 mx-auto max-w-2xl">Want {data.title.toLowerCase()} done properly?</h2>
    <a href="/contact/" class="btn btn-primary mt-9">Book a consultation</a>
  </section>

  <script>
    import '../../scripts/service';
  </script>
</Base>

<style is:global>
  .svc-canvas { display: none; }
  .svc-inner { padding-top: 8rem; text-align: center; }
  .svc-copy .lead { margin-inline: auto; max-width: 40rem; }
  .svc-cta { justify-content: center; }

  html.svc-on .svc { height: 230vh; }
  html.svc-on .svc-stage { position: sticky; top: 0; height: 100svh; overflow: hidden; }
  html.svc-on .svc-canvas { display: block; position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; transition: opacity .9s ease; }
  html.svc-on .svc-inner { position: relative; display: flex; align-items: center; height: 100%; padding-top: 4rem; text-align: left; }
  html.svc-on .svc-copy { max-width: 31rem; }
  html.svc-on .svc-copy .lead { margin-inline: 0; }
  html.svc-on .svc-cta { justify-content: flex-start; }
  html.svc-on .svc-fallback { display: none; }
  @media (max-width: 767px) {
    html.svc-on .svc-inner { align-items: flex-start; padding-top: 6.5rem; text-align: center; }
    html.svc-on .svc-copy { max-width: none; }
    html.svc-on .svc-copy .lead { margin-inline: auto; }
    html.svc-on .svc-cta { justify-content: center; }
  }
</style>

