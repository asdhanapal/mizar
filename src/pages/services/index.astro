---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
---

<Base
  title="Services: Software, Web, Cloud, CRM and Marketing"
  description="SaaS and web development, Android apps, CRM integration, AWS cloud, SEO and digital marketing, and WhatsApp messaging from one engineering-led team."
  jsonLd={[{
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: services.map((s, i) => ({ '@type': 'ListItem', position: i + 1, url: `https://skandava.com/services/${s.id}/`, name: s.data.title })),
  }]}
>
  <PageHero title="Engineering and marketing under one roof." lead="Pick one service or combine them. Each is delivered by the engineers who will still be around after launch." crumbs={[{ label: 'Services' }]} />
  <section class="mx-auto max-w-[1200px] px-3 pb-3">
    <ul class="grid gap-3 md:grid-cols-2">
      {services.map((s, i) => (
        <li class:list={['tile flex min-h-[22rem] flex-col items-center justify-center px-8 py-14', (i + Math.floor(i / 2)) % 2 === 0 ? 'tile-dark' : 'tile-light']}>
          <h2 class="h3"><a href={`/services/${s.id}/`} class="after:absolute after:inset-0">{s.data.title}</a></h2>
          <p class="sub mt-3 max-w-sm text-[1.25rem] leading-snug">{s.data.summary}</p>
          <span class="link mt-4 text-[1.2rem]" aria-hidden="true">Learn more</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="container-x max-w-3xl py-20" aria-labelledby="guide-h">
    <h2 id="guide-h" class="h2 mb-10">Which one do you need?</h2>
    <dl class="divide-y divide-line border-y border-line">
      {services.filter((s) => s.data.answer).map((s) => (
        <div class="py-6">
          <dt class="text-[1.3rem] font-semibold tracking-tight"><a href={`/services/${s.id}/`} class="link">{s.data.title}</a></dt>
          <dd class="mt-2 text-[1.1rem] leading-relaxed text-muted">{s.data.answer}</dd>
        </div>
      ))}
    </dl>
    <p class="mt-10 text-[1.1rem] leading-relaxed text-muted">
      Looking for a product instead of a project? See <a href="/core/" class="link">CORE, our call recorder for sales teams</a>, or try the <a href="/tools/" class="link">free tools</a>. Building for a client of your own? Read how <a href="/partners/" class="link">partners work with us</a>. Want to know who is behind the work? See <a href="/about/" class="link">about Skandava</a>.
    </p>
  </section>
</Base>
