---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import gsquare from '../assets/clients/gsquare-logo.webp';
import rayala from '../assets/clients/rayala-logo.svg';
import seagreen from '../assets/clients/seagreen-logo.jpg';
import gra from '../assets/clients/gra-logo.png';
import logonw from '../assets/clients/logonw-logo.webp';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);

const chapters = [
  { n: '01', title: 'Build it right.', text: 'Custom web apps, Android apps, APIs and CRM integrations, engineered by people who have shipped them in production.', href: '/services/software-development/', cta: 'Software development' },
  { n: '02', title: 'Get found.', text: 'Technical SEO, content and paid media, built into the product from the first commit instead of bolted on after launch.', href: '/services/seo-digital-marketing/', cta: 'SEO & digital marketing' },
  { n: '03', title: 'Scale it safely.', text: 'AWS architecture, automation and compliant WhatsApp messaging that keep working as your customer base grows.', href: '/services/cloud-aws/', cta: 'Cloud & AWS' },
];

const clients = [
  { name: 'Gsquare Technologies', logo: gsquare, url: 'https://www.gsquare-tech.com' },
  { name: 'Rayala Corporation', logo: rayala, url: 'https://www.rayala.com' },
  { name: 'Seagreen', logo: seagreen, url: 'https://www.seagreen.in' },
  { name: 'GRA', logo: gra },
  { name: 'LogoNW', logo: logonw },
];
---

<Base
  title="Skandava — Software Development, AWS & SEO Company"
  description="Skandava is an engineering-led team building custom software, AWS cloud systems, WhatsApp messaging platforms and SEO that gets you found. Book a free consultation."
  jsonLd={[{
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    name: 'Skandava',
    url: 'https://skandava.com',
    description: 'Software development, cloud, SEO and digital marketing services.',
    serviceType: ['Software development', 'Cloud architecture', 'SEO', 'Digital marketing', 'WhatsApp Business messaging'],
    parent: { '@id': 'https://skandava.com/#organization' },
  }]}
>
  <canvas id="scene" aria-hidden="true" class="pointer-events-none fixed inset-0 z-0 h-full w-full opacity-0 transition-opacity duration-1000 max-md:!opacity-60"></canvas>

  <div id="scene-zone" class="relative z-10">
    <!-- Hero -->
    <section class="relative flex min-h-[100svh] items-center pt-24">
      <div class="glow" aria-hidden="true"></div>
      <div class="container-x">
        <p class="eyebrow mb-6">Software · Cloud · Growth</p>
        <h1 class="h1 max-w-4xl">We engineer software.<br /><span class="gradient-text">We engineer growth.</span></h1>
        <p class="lead mt-8 max-w-xl">
          Skandava is an engineering-led team building custom software, AWS cloud systems, WhatsApp messaging and SEO that gets you found.
        </p>
        <div class="mt-10 flex flex-wrap gap-4">
          <a href="/contact/" class="btn btn-primary">Book a free consultation</a>
          <a href="/services/" class="btn btn-ghost">Explore services</a>
        </div>
      </div>
    </section>

    <!-- Scroll story: all copy is real HTML; JS only adds the sticky/animated behaviour -->
    <section id="story" class="story">
      <div class="story-stage">
        <div class="container-x">
          {chapters.map((c) => (
            <article data-chapter class="chapter max-w-xl">
              <p class="eyebrow mb-4">{c.n}</p>
              <h2 class="h2">{c.title}</h2>
              <p class="lead mt-5">{c.text}</p>
              <a href={c.href} class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-accent-2 hover:underline">{c.cta} →</a>
            </article>
          ))}
        </div>
      </div>
    </section>
  </div>

  <div class="relative z-10 bg-bg">
    <!-- Services -->
    <section class="container-x py-28" aria-labelledby="services-h">
      <p class="eyebrow mb-4" data-reveal>What we do</p>
      <h2 id="services-h" class="h2 max-w-2xl" data-reveal>One team for the code, the cloud and the customers.</h2>
      <div class="mt-14 grid gap-5 sm:grid-cols-2">
        {services.map((s, i) => (
          <a href={`/services/${s.id}/`} class="card group" data-reveal style={`transition-delay:${i * 60}ms`}>
            <h3 class="text-2xl font-semibold">{s.data.title}</h3>
            <p class="mt-3 text-muted">{s.data.summary}</p>
            <span class="mt-6 inline-block text-sm font-semibold text-accent-2 transition group-hover:translate-x-1">Learn more →</span>
          </a>
        ))}
      </div>
    </section>

    <!-- CORE spotlight -->
    <section class="container-x pb-28" aria-labelledby="core-h">
      <div class="relative overflow-hidden rounded-3xl border border-line bg-surface p-8 sm:p-14" data-reveal>
        <div class="glow glow-core" aria-hidden="true"></div>
        <p class="eyebrow mb-4">Our product</p>
        <h2 id="core-h" class="h2 max-w-2xl">CORE: every offline call, <span class="gradient-text">recorded, synced, visible.</span></h2>
        <p class="lead mt-6 max-w-2xl">
          When agents switch to personal phones because VoIP gets flagged as spam, your CRM goes blind. CORE is an Android app that automatically records those calls and syncs them to your CRM.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href="/core/" class="btn btn-primary">See how CORE works</a>
          <a href="/contact/" class="btn btn-ghost">Book a demo</a>
        </div>
      </div>
    </section>

    <!-- Clients -->
    <section class="container-x pb-28" aria-labelledby="clients-h">
      <h2 id="clients-h" class="eyebrow mb-8 text-center">Trusted by teams at</h2>
      <ul class="flex flex-wrap items-center justify-center gap-4">
        {clients.map((c) => (
          <li class="flex h-20 w-44 items-center justify-center rounded-xl bg-white px-4">
            {c.url ? (
              <a href={c.url} rel="noopener" target="_blank" aria-label={c.name}>
                <Image src={c.logo} alt={c.name} height={48} class="h-10 w-auto max-w-[9rem] object-contain" loading="lazy" />
              </a>
            ) : (
              <Image src={c.logo} alt={c.name} height={48} class="h-10 w-auto max-w-[9rem] object-contain" loading="lazy" />
            )}
          </li>
        ))}
      </ul>
    </section>

    <!-- CTA -->
    <section class="container-x pb-8 text-center" aria-labelledby="cta-h">
      <h2 id="cta-h" class="h2 mx-auto max-w-3xl">Have a product to build or a market to reach?</h2>
      <p class="lead mx-auto mt-5 max-w-xl">Tell us where you are. We will tell you honestly what it takes.</p>
      <a href="/contact/" class="btn btn-primary mt-8">Book a free consultation</a>
    </section>
  </div>

  <script>
    import '../scripts/home';
  </script>
</Base>

<style is:global>
  .glow {
    position: absolute; inset: 0; pointer-events: none; z-index: -1;
    background:
      radial-gradient(60% 50% at 20% 20%, rgb(99 102 241 / .22), transparent 70%),
      radial-gradient(50% 40% at 85% 70%, rgb(34 211 238 / .12), transparent 70%);
  }
  .glow-core { z-index: 0; opacity: .8; }
  .glow-core ~ * { position: relative; z-index: 1; }

  /* Story: stacked normally by default; sticky + crossfade once JS enables it */
  .story .chapter { padding-block: 5rem; }
  html.story-on .story { height: 320vh; }
  html.story-on .story-stage { position: sticky; top: 0; height: 100svh; display: flex; align-items: center; }
  html.story-on .story .container-x { position: relative; height: 100%; display: flex; align-items: center; }
  html.story-on .story .chapter {
    position: absolute; padding-block: 0; opacity: 0; transform: translateY(24px); pointer-events: none;
    transition: opacity .6s ease, transform .6s ease;
  }
  html.story-on .story .chapter.is-active { opacity: 1; transform: none; pointer-events: auto; }
</style>
